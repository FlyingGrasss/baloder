generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["baloder"]
}

enum UserRole {
  USER
  ADMIN

  @@schema("baloder")
}

model User {
  id               String   @id
  email            String   @unique
  name             String
  picture          String?
  tc               String?
  schoolNumber     String?
  graduationYear   Int?
  phoneNumber      String?
  birthDate        DateTime?
  role             UserRole @default(USER)
  verified         Boolean  @default(false)
  isMember         Boolean  @default(false)
  isSandikMember   Boolean  @default(false)
  memberRequested  Boolean  @default(false)
  sandikRequested  Boolean  @default(false)
  balance          Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  depositRequests    DepositRequest[]
  walletTransactions WalletTransaction[]
  idCardOrders       IdCardOrder[]
  stockHistories     StockHistory[]

  @@map("baloder_profile_info")
  @@schema("baloder")
}

model OAuthAttempt {
  stateHash    String   @id
  codeVerifier String
  nextPath     String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
  @@map("oauth_attempts")
  @@schema("baloder")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  date      DateTime @default(now())
  excerpt   String
  content   String?  @db.Text
  createdAt DateTime @default(now())

  @@map("announcements")
  @@schema("baloder")
}

model Budget {
  id           String        @id @default(cuid())
  name         String
  total        Float
  spent        Float         @default(0)
  transactions Transaction[]

  @@map("budgets")
  @@schema("baloder")
}

model Transaction {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  amount    Float
  category  String
  detail    String
  budgetId  String
  budget    Budget   @relation(fields: [budgetId], references: [id])

  @@map("transactions")
  @@schema("baloder")
}

model DepositRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Float
  receiptUrl  String
  pathname    String?
  size        Int?
  contentType String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@map("deposit_requests")
  @@schema("baloder")
}

model WalletTransaction {
  id        String   @id @default(cuid())
  items     String[]
  total     Float
  date      DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@map("wallet_transactions")
  @@schema("baloder")
}

model ContactMessage {
  id        String   @id @default(cuid())
  ip        String?
  name      String
  email     String
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@map("contact_messages")
  @@schema("baloder")
}

model ContactApplication {
  trackingNo String   @id
  studentNo  String
  firstName  String
  lastName   String
  period     String
  phone      String
  email      String
  type       String
  subject    String
  message    String   @db.Text
  status     String   @default("İşlemde")
  response   String?  @db.Text
  createdAt  DateTime @default(now())

  @@map("contact_applications")
  @@schema("baloder")
}

model IdCardOrder {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  name            String
  studentNo       String
  department      String
  deliveryDetails String
  receiptUrl      String
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("id_card_orders")
  @@schema("baloder")
}

model MarketItem {
  id           String         @id @default(cuid())
  name         String
  imageUrl     String
  sellPrice    Float
  stock        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  stockHistory StockHistory[]

  @@map("market_items")
  @@schema("baloder")
}

model StockHistory {
  id           String     @id @default(cuid())
  marketItemId String
  marketItem   MarketItem @relation(fields: [marketItemId], references: [id], onDelete: Cascade)
  delta        Int
  note         String?
  createdAt    DateTime   @default(now())
  updatedBy    String
  user         User       @relation(fields: [updatedBy], references: [id])

  @@map("stock_history")
  @@schema("baloder")
}
