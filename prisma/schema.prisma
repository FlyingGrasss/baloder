generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model ContactMessage {
  id        String   @id @default(cuid())
  ip        String   // Added this to track the sender
  name      String
  email     String
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@map("contact_messages")
}
